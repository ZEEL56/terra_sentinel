# PostgreSQL connection string (required for /api/save-user and optional dashboard DB queries)
# Use Vercel Postgres, Neon, Supabase, or Railway — example:
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# OpenWeatherMap API key for live rainfall data (optional — falls back to mock data)
NEXT_PUBLIC_OPENWEATHER_API_KEY=your_api_key_here

# WebSocket URL for live satellite streaming (optional — defaults to localhost for dev)
# Vercel does NOT support persistent WebSocket servers; deploy WS separately on Render/Railway/Fly.io
# NEXT_PUBLIC_WS_URL=wss://your-ws-server.example.com/satellite-stream
